# Salin menjadi supabase/scripts/.env lalu isi nilainya. File .env TIDAK masuk git.
# Kunci secret memberi akses penuh ke database. Jangan dibagikan dan jangan dipakai di frontend.
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Secret key (Project Settings → API Keys). Nama lama SUPABASE_SERVICE_ROLE_KEY masih diterima.
SUPABASE_SECRET_KEY=isi-secret-key-di-sini
# Domain email sintetis untuk login kode siswa (architecture.md §5, usulan sementara [Konfirmasi]).
# Email ini tidak pernah dipakai mengirim surat. HARUS sama dengan VITE_SISWA_DOMAIN di app/.env.
SISWA_DOMAIN=siswa.mathsave.app
