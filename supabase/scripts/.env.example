# Salin menjadi supabase/scripts/.env lalu isi nilainya. File .env TIDAK masuk git.
# Kunci service_role memberi akses penuh ke database. Jangan dibagikan dan jangan dipakai di frontend.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-di-sini
# Domain email sintetis untuk login kode siswa (architecture.md §5, masih [Konfirmasi]).
# Email ini tidak pernah dipakai mengirim surat. Contoh di api.md §2.1:
SISWA_DOMAIN=siswa.mathsave.app
