# Salin file ini menjadi app/.env lalu isi nilainya (supabase/README.md §4). File .env TIDAK masuk git.
# Hanya kunci PUBLIK yang boleh ada di frontend. Jangan pernah mengisi secret / service_role key di sini.
# Selama URL dan kunci kosong, aplikasi berjalan dalam mode uji (login tanpa server).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable key (Project Settings → API Keys). Nama lama VITE_SUPABASE_ANON_KEY masih diterima.
VITE_SUPABASE_PUBLISHABLE_KEY=isi-publishable-key-di-sini
# Domain email sintetis login kode siswa. HARUS sama dengan SISWA_DOMAIN di supabase/scripts/.env.
# Usulan sementara [Konfirmasi], architecture.md §5. Jika kosong, dipakai siswa.mathsave.app.
VITE_SISWA_DOMAIN=siswa.mathsave.app 